# --- Song recognition ---
# https://dashboard.audd.io
AUDD_API_TOKEN=

# --- Google Calendar ---
# https://console.cloud.google.com — create OAuth client, add the redirect URI below
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# --- Outlook / Microsoft 365 Calendar ---
# https://portal.azure.com — App registrations, add the redirect URI below
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback

# Apple/iCloud Calendar needs no app registration — you connect it from the
# app's UI with your Apple ID email and an app-specific password generated at
# https://appleid.apple.com. Nothing to put here.

# --- Spotify (create a playlist from a session's tracks) ---
# https://developer.spotify.com/dashboard — create an app, add the redirect URI below
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://localhost:3000/auth/spotify/callback

# Comma-separated, case-insensitive. Matched against event titles.
CLASS_KEYWORDS=yoga,hiit,spin,pilates,cycling,barre,boxing,zumba,crossfit,bootcamp,workout,class

PORT=3000
